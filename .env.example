# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/social_platform_dev?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=social_platform_dev
POSTGRES_PORT=5432

# Redis In-Memory Cache & Message Broker
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# MinIO / AWS S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=social-media-media
S3_PUBLIC_URL=http://localhost:9000/social-media-media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Authentication & Security
JWT_ACCESS_SECRET="enterprise_super_secret_access_key_change_in_production_32char_min"
JWT_REFRESH_SECRET="enterprise_super_secret_refresh_key_change_in_production_32char_min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="cookie_signing_secret_key_minimum_32_characters_here"

# SMTP Mail Server (MailHog for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@socialplatform.dev"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000
